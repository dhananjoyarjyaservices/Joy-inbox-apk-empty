# Firebase web app configuration (public client values; restrict API key by referrer in Google Cloud)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID

# Firebase Cloud Messaging Web Push public key from Firebase Console > Project settings > Cloud Messaging
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_WEB_PUSH_VAPID_PUBLIC_KEY

# AWS Lambda Function URL (must include https:// and no trailing slash)
VITE_API_BASE_URL=https://YOUR_LAMBDA_FUNCTION_URL
