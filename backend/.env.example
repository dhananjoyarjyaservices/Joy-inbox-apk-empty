# Firebase Admin SDK
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET

# Alternative: use complete service account JSON instead.
# If used, the three FIREBASE_* values above are not required.
# FIREBASE_SERVICE_ACCOUNT=YOUR_SERVICE_ACCOUNT_JSON

# SaaS tenant WhatsApp credential encryption.
# Generate a random 32-byte key and base64-encode it. Store only in AWS Secrets Manager
# or a protected Lambda environment variable; NEVER use a VITE_ prefix or commit the real value.
TENANT_SECRET_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Legacy single-owner WhatsApp Cloud API routes (do not use for new tenant connections)
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
GRAPH_API_VERSION=v26.0

# Meta webhook security
META_APP_SECRET=YOUR_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# Exact frontend origin(s), comma-separated. Include the production Pages URL.
CORS_ORIGINS=https://final-joy-inbox.pages.dev

# Stripe subscription billing (configure only after creating Products/Prices in Stripe)
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET
STRIPE_PRICE_STARTER=price_REPLACE_WITH_STARTER_PRICE_ID
STRIPE_PRICE_GROWTH=price_REPLACE_WITH_GROWTH_PRICE_ID
STRIPE_PRICE_BUSINESS=price_REPLACE_WITH_BUSINESS_PRICE_ID
BILLING_SUCCESS_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=success&session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=cancelled
BILLING_PORTAL_RETURN_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=portal

# Production campaign suppression pseudonymization (shared by API/webhook and campaign worker)
CAMPAIGN_SUPPRESSION_HASH_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY
