# Firebase Admin SDK
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_PRIVATE_KEY"
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET

# Alternative: use complete service account JSON instead.
# If used, the three FIREBASE_* values above are not required.
# FIREBASE_SERVICE_ACCOUNT=YOUR_SERVICE_ACCOUNT_JSON

# SaaS tenant WhatsApp credential encryption.
# Generate a random 32-byte key and base64-encode it. Store only in AWS Secrets Manager
# or a protected Lambda environment variable; NEVER use a VITE_ prefix or commit the real value.
TENANT_SECRET_ENCRYPTION_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY

# Legacy single-owner API compatibility is disabled by default.
# Set true only for a controlled migration window; new tenant routes do not use this flag.
LEGACY_OWNER_API_ENABLED=false
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
GRAPH_API_VERSION=v26.0

# Meta app + WhatsApp Embedded Signup v4 (server-only secret; public IDs are returned by an authenticated config endpoint)
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_EMBEDDED_SIGNUP_CONFIG_ID=YOUR_FACEBOOK_LOGIN_FOR_BUSINESS_CONFIG_ID
# Optional: only when Meta has issued a partner solution ID for this integration.
META_EMBEDDED_SIGNUP_SOLUTION_ID=YOUR_META_SOLUTION_ID
GRAPH_API_VERSION=v26.0

# Select tech_provider (Meta bills the customer directly) or solution_partner
# (requires Meta-approved partner status, system-user token and extended credit line).
META_PARTNER_MODE=tech_provider
# Keep false until Joy Inbox has metered Meta usage, customer invoicing and collections.
META_USAGE_BILLING_ENABLED=false
META_SYSTEM_USER_ID=YOUR_PARTNER_SYSTEM_USER_ID
META_SYSTEM_USER_ACCESS_TOKEN=YOUR_PARTNER_SYSTEM_USER_ACCESS_TOKEN
META_EXTENDED_CREDIT_LINE_ID=YOUR_EXTENDED_CREDIT_LINE_ID
META_CREDIT_LINE_CURRENCY=INR

# Meta webhook security
WHATSAPP_VERIFY_TOKEN=YOUR_WEBHOOK_VERIFY_TOKEN

# Public frontend origin used to build invitation acceptance links. Preserve any deployment base path.
FRONTEND_BASE_URL=https://YOUR_FRONTEND_DOMAIN

# Exact frontend origin(s), comma-separated. Include the production Pages URL.
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Stripe subscription billing. Create all five monthly and five annual recurring Prices
# in Stripe test mode first, then replace every placeholder with its real Price ID.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_SECRET
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# Monthly recurring Price IDs
STRIPE_PRICE_LITE=price_REPLACE_WITH_LITE_MONTHLY_PRICE_ID
STRIPE_PRICE_STARTER=price_REPLACE_WITH_STARTER_MONTHLY_PRICE_ID
STRIPE_PRICE_GROWTH=price_REPLACE_WITH_GROWTH_MONTHLY_PRICE_ID
STRIPE_PRICE_BUSINESS=price_REPLACE_WITH_BUSINESS_MONTHLY_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_PRO_MONTHLY_PRICE_ID

# Annual recurring Price IDs (two months free)
STRIPE_PRICE_LITE_ANNUAL=price_REPLACE_WITH_LITE_ANNUAL_PRICE_ID
STRIPE_PRICE_STARTER_ANNUAL=price_REPLACE_WITH_STARTER_ANNUAL_PRICE_ID
STRIPE_PRICE_GROWTH_ANNUAL=price_REPLACE_WITH_GROWTH_ANNUAL_PRICE_ID
STRIPE_PRICE_BUSINESS_ANNUAL=price_REPLACE_WITH_BUSINESS_ANNUAL_PRICE_ID
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_WITH_PRO_ANNUAL_PRICE_ID

# Configure trusted HTTPS return URLs for the deployed frontend.
BILLING_SUCCESS_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=success&session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=cancelled
BILLING_PORTAL_RETURN_URL=https://YOUR_FRONTEND_DOMAIN/inbox?billing=portal

# Production campaign suppression pseudonymization (shared by API/webhook and campaign worker)
CAMPAIGN_SUPPRESSION_HASH_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY
